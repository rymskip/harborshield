# Development Dockerfile
# Provides a full development environment with pixi and Docker-in-Docker
# Uses Debian base with Docker installed for glibc compatibility with pixi

FROM debian:bookworm-slim

# Install system dependencies and Docker
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    ca-certificates \
    nftables \
    iptables \
    git \
    curl \
    openssh-server \
    bash \
    gcc \
    gnupg \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*

# Install Docker
RUN curl -fsSL https://get.docker.com | sh

# Install pixi for toolchain management
RUN curl -fsSL https://pixi.sh/install.sh | sh
ENV PATH="/root/.pixi/bin:${PATH}"

# Install Rust and Node.js via pixi
RUN pixi global install rust && \
    pixi global install nodejs

# Add pixi to PATH for all shell sessions (SSH, bash, etc.)
RUN echo 'export PATH="/root/.pixi/bin:$PATH"' >> /root/.bashrc && \
    echo 'export PATH="/root/.pixi/bin:$PATH"' >> /root/.profile && \
    echo 'export PATH="/root/.pixi/bin:$PATH"' >> /etc/profile

# Setup SSH for Zed remote development
RUN mkdir -p /var/run/sshd && \
    echo 'root:dev' | chpasswd && \
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config

# Expose SSH port
EXPOSE 22

WORKDIR /app

# Startup script to run both dockerd and sshd
COPY <<'EOF' /start.sh
#!/bin/bash
set -e

# Start Docker daemon in background
dockerd &

# Wait for Docker to be ready
echo "Waiting for Docker daemon..."
while ! docker info > /dev/null 2>&1; do
    sleep 1
done
echo "Docker daemon ready!"

# Start SSH daemon
/usr/sbin/sshd

# Keep container running
sleep infinity
EOF
RUN chmod +x /start.sh

CMD ["/start.sh"]

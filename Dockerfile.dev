# Development Dockerfile
# Provides a full development environment with pixi and Docker-in-Docker

FROM docker:dind

# Install system dependencies
RUN apk add --no-cache \
    pkgconfig \
    openssl-dev \
    ca-certificates \
    nftables \
    git \
    curl \
    openssh \
    bash \
    musl-dev \
    gcc

# Install pixi for toolchain management
RUN curl -fsSL https://pixi.sh/install.sh | sh
ENV PATH="/root/.pixi/bin:${PATH}"

# Install Rust and Docker CLI via pixi
RUN pixi global install rust && \
    pixi global install docker

# Setup SSH for Zed remote development
RUN mkdir -p /var/run/sshd && \
    echo 'root:dev' | chpasswd && \
    ssh-keygen -A && \
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config

# Expose SSH port
EXPOSE 22

WORKDIR /app

# Startup script to run both dockerd and sshd
COPY <<'EOF' /start.sh
#!/bin/bash
set -e

# Start Docker daemon in background
dockerd-entrypoint.sh dockerd &

# Wait for Docker to be ready
echo "Waiting for Docker daemon..."
while ! docker info > /dev/null 2>&1; do
    sleep 1
done
echo "Docker daemon ready!"

# Start SSH daemon
/usr/sbin/sshd

# Keep container running
sleep infinity
EOF
RUN chmod +x /start.sh

CMD ["/start.sh"]
